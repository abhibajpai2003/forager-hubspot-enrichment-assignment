# Copy to .env for local runs. On Railway, set these as service variables instead.

# --- Forager -------------------------------------------------------------------------------
# mock = fake data, 0 credits. live = real Forager calls.
FORAGER_MODE=mock
FORAGER_API_KEY=
# Find it with: uv run python -m scripts.forager_check accounts
FORAGER_ACCOUNT_ID=
FORAGER_BASE_URL=https://api-v2.forager.ai
# Hard cap on credits this service may spend (tracked in FORAGER_CACHE_DIR/credit_ledger.json)
FORAGER_CREDIT_BUDGET=45
FORAGER_CACHE_DIR=.forager_cache
FORAGER_EMAIL_TIMEOUT_SECONDS=180
# Phone lookups cost 15 credits each; off to stay within budget.
ENABLE_PHONE_LOOKUP=false

# --- HubSpot -------------------------------------------------------------------------------
# Private app access token
HUBSPOT_ACCESS_TOKEN=
# Private app client secret (used to verify webhook signatures)
HUBSPOT_CLIENT_SECRET=
# Public URL of this service, e.g. https://your-app.up.railway.app (needed for signature checks
# behind a proxy; falls back to X-Forwarded-* headers when empty)
PUBLIC_BASE_URL=

# --- Enrichment ----------------------------------------------------------------------------
DEFAULT_JOB_TITLES=Account Executive,Recruiter,Solutions Engineer,Partnerships,Customer Success
MAX_CONTACTS_PER_COMPANY=5
# Wait before processing a webhook so associations made right after creation are visible
WEBHOOK_DELAY_SECONDS=10
# true = Forager values replace existing HubSpot values (email and domain are never replaced)
ENRICHMENT_OVERWRITE=false

# --- Service -------------------------------------------------------------------------------
# Required for the /enrich, /companies and /credits endpoints (sent as the X-Admin-Key header)
ADMIN_API_KEY=
LOG_LEVEL=INFO
LOG_FORMAT=json
